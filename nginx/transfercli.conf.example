# TransferCLI nginx vhost example (install.sh writes the same file when TC_DOMAIN is set)
# Copy to /etc/nginx/sites-available/transfercli, edit server_name, then:
#   ln -s /etc/nginx/sites-available/transfercli /etc/nginx/sites-enabled/
#   certbot --nginx -d your.host

server {
    listen 80;
    listen [::]:80;
    server_name files.example.com;

    # Disable IP logging for privacy (optional)
    access_log off;
    server_tokens off;

    # Allow large uploads (stream through, no buffering)
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    # OVERWRITE client address headers (never $proxy_add_x_forwarded_for): transfer.sh trusts the first
    # address in X-Forwarded-For for rate limiting, and a client could otherwise put any address there.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Admin panel: authenticates every request itself (bcrypt, TC_ADMIN_HTPASSWD)
    location = /admin { proxy_pass http://127.0.0.1:8082; }
    location /admin/  { proxy_pass http://127.0.0.1:8082; }

    # transfer.sh upload backend (uploads require the upload password by default)
    location / {
        proxy_pass http://127.0.0.1:8081;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
    }
}
